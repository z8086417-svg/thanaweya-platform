# ============================================================
# نسخ من هذا الملف إلى ".env" في نفس المجلد، وحط القيم بتاعتك.
# إعدادات على مستوى السيرفر (بتتكتب من لوحة الإدارة في الصفحة ⚙️ الإعدادات).
# ============================================================

# سرية: غيّرها لسلسلة عشوائية طويلة (مهم جدًا للإنتاج)
SECRET_KEY=change-me-to-a-long-random-string

# مفتاح الذكاء الاصطناعي (Anthropic Claude) - اختياري، وبيتحط كمان
# من لوحة الإدارة ← الإعدادات
ANTHROPIC_API_KEY=

# بيانات حساب الرئيس (اول تشغيل فقط)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2026
